{
    name: majid-shafik/filament-media-library,
    description: An advanced, secure, and modern centralized Media Library plugin for Filament 5 with SHA-256 deduplication, hierarchical category tree, usage tracking, and native RTL support.,
    type: library,
    keywords: [
        laravel,
        filament,
        filamentphp,
        filament-plugin,
        media-library,
        deduplication,
        image-picker,
        media-manager,
        rtl
    ],
    homepage: https://github.com/Majid-Shafik/filament-media-library,
    support: {
        issues: https://github.com/Majid-Shafik/filament-media-library/issues,
        source: https://github.com/Majid-Shafik/filament-media-library
    },
    license: MIT,
    authors: [
        {
            name: Majid Shafik,
            homepage: https://github.com/Majid-Shafik,
            role: Developer
        }
    ],
    require: {
        php: ^8.2,
        filament/filament: ^5.0,
        spatie/laravel-package-tools: ^1.15
    },
    require-dev: {
        larastan/larastan: ^3.0,
        laravel/pint: ^1.0,
        orchestra/testbench: ^9.0|^10.0|^11.0,
        pestphp/pest: ^3.7|^4.0,
        pestphp/pest-plugin-laravel: ^3.0|^4.0
    },
    autoload: {
        psr-4: {
            MajidShafik\\FilamentMediaLibrary\: src/,
            MajidShafik\\FilamentMediaLibrary\\Database\\Factories\: database/factories/
        }
    },
    autoload-dev: {
        psr-4: {
            MajidShafik\\FilamentMediaLibrary\\Tests\: tests/
        }
    },
    scripts: {
        analyse: phpstan analyse,
        test: pest,
        test:lint: pint --test
    },
    extra: {
        laravel: {
            providers: [
                MajidShafik\\FilamentMediaLibrary\\FilamentMediaLibraryServiceProvider
            ]
        }
    },
    config: {
        sort-packages: true,
        allow-plugins: {
            pestphp/pest-plugin: true,
            phpstan/extension-installer: true
        }
    },
    minimum-stability: stable,
    prefer-stable: true
}
